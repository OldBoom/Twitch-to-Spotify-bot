# Spotify (Authorization Code Flow; Premium account required)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_TOKENS_PATH=.tokens.json

# Twitch application (dev.twitch.tv)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_ID=
TWITCH_OWNER_ID=
TWITCH_CHANNEL_LOGIN=

# Command / abuse controls
COMMAND_PREFIX=!
SR_COOLDOWN_SECONDS=60
SR_MAX_PENDING_PER_USER=0
SR_MAX_TRACK_DURATION_SECONDS=480
BLOCKLIST_PATH=blocklist.json
CHAT_RATE_LIMIT_MESSAGES=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=30
